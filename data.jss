const LESSONS = [
{"u":0,"w":1,"t":"How do people live in different environments?","x":"Grandma and the Great Gourd","g":"Folktale","s":["3.5a - Story elements","3.4 - Context clues"],"c":"Story Structure and Plot Sequence","vi":"Unit 1: Vocabulary Builder","p":{"co":"Identify key story elements using text evidence.","lo":"Describe story structure using: First blank, then blank, finally blank.","wd":{"ELP 1":"Point to characters and settings in illustrations; yes or no responses","ELP 2":"Complete story map with word bank","ELP 3":"Describe problem and solution using story map with sentence starters","ELP 4":"Retell in sequence using academic vocabulary and transition words","ELP 5-6":"Analyze how setting affects character actions; cite two text details"},"v1":["travel","forest","home","river","gourd"],"v2":["journey","obstacle","trickster","environment"],"v3":["plot structure","narrative arc","folktale conventions"],"ac":"Story Element Anchor Chart - Co-create class chart; students add character, setting, problem, solution using sticky notes and sentence frames.","mn":["Story map graphic organizer","Character and setting picture cards","Sticky notes (2 colors)","Word wall cards"],"sc":["Bilingual glossary on desk","Story map with visual prompts","Sentence frames on cards","Co-teacher models think-aloud during read"],"df":{"b":"Partially completed story map with 1 blank plus picture card support","o":"Complete story map and write 2 sentences about the journey","a":"Journal entry from character perspective using story vocabulary","e":"ELP 1-2: gesture and word; ELP 3-4: sentence frames; ELP 5-6: paragraph"},"ms":["May think folktale is true - clarify: fictional stories passed down through generations","May confuse environment with home - use bilingual anchor chart with visuals"],"tp":"Before reading: How do YOU travel to different places? Activates schema about environments and travel."},"l":{"co":"Identify the character and one problem or solution with visual support.","lo":"Use: The character blank because blank to describe story events.","wd":{"ELP 1":"Match character pictures to words; point to the problem","ELP 2":"Fill in 2-part story map with word bank","ELP 3":"Complete 3-part story map with sentence starters","ELP 4":"Retell beginning, middle, end in 3 sentences with academic vocabulary","ELP 5-6":"Compare this folktale to another familiar text using evidence"},"v1":["travel","forest","gourd"],"v2":["journey","obstacle","trickster"],"v3":["folktale elements"],"ac":"Mini Story Map - 4-panel picture retelling cards; students sequence events and write 1 sentence per card.","mn":["Mini story sequencing cards","Sentence frame strips","Mini whiteboard and markers","T-chart: Problem and Solution"],"sc":["Teacher-led picture walk before reading","Vocabulary preview with illustrations","Choral reading of key passages"],"df":{"b":"Use 2 sequencing cards; accept drawing plus 1 word; L1 vocabulary support","o":"4-card sequence plus write 2 sentences with sentence frames","a":"Write a 3-4 sentence retelling paragraph independently","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["May not distinguish folktale from realistic fiction - ask: Could this really happen?","May confuse a detail with the main problem - use a Before and After chart"],"tp":"Give each student a sticky note to draw one thing different between their neighborhood and the story environment."}},
{"u":0,"w":2,"t":"How do different cultures relate to their environment?","x":"Why the Sky Is Far Away","g":"West African Folktale","s":["3.5b - Identify theme","3.4 - Context clues"],"c":"Theme and Cultural Connections","vi":"Unit 1: Listening and Speaking","p":{"co":"Identify the theme of a folktale and support it with two text details.","lo":"State: The message is blank because in the story blank.","wd":{"ELP 1":"Identify theme picture from 3 options; gesture or point","ELP 2":"Select theme from word bank; paste onto graphic organizer","ELP 3":"Write theme plus one text detail using sentence starters","ELP 4":"Explain theme with two supporting details in full sentences","ELP 5-6":"Evaluate how theme connects to a real-world issue; cite evidence"},"v1":["sky","food","waste","people"],"v2":["theme","consequence","greed","cultural"],"v3":["moral lesson","universal theme","oral tradition"],"ac":"Theme Detective Chart - Pairs find 2 story clues pointing to the theme.","mn":["Theme Detective graphic organizer","Clue card strips","Anchor chart: Theme vs Topic","Word wall: theme vocabulary"],"sc":["Theme sentence frame on board","Visual anchor chart: Theme vs Topic","Pre-selected text excerpts for ELP 1-2","Partner discussion sentence starters"],"df":{"b":"Pre-identified clue sticky notes; match clue to theme with picture support","o":"Find 2 clues independently; write theme sentence using frame","a":"Compare theme to Week 1 folktale: Both stories teach blank","e":"ELP 1-2: point and picture card; ELP 3: sentence frame; ELP 4-6: paragraph"},"ms":["Students confuse theme with topic - ask: What does this teach us about LIFE?","ELL students may interpret theme too literally - redirect to the deeper moral"],"tp":"Hold up two food items: What would happen if we wasted ALL of this? Builds consequence schema before reading."},"l":{"co":"Identify the theme of a folktale with teacher support.","lo":"Name the theme using a provided sentence frame.","wd":{"ELP 1":"Point to theme from 2 picture choices","ELP 2":"Fill in: The theme is blank (word bank)","ELP 3":"Write theme plus one story detail","ELP 4":"Explain theme in 2 sentences with vocabulary","ELP 5-6":"Connect theme to a personal experience in writing"},"v1":["sky","food","waste"],"v2":["theme","consequence","greed"],"v3":["moral lesson"],"ac":"Theme Sort - Sort 5 event cards as shows the theme or does not show the theme.","mn":["Event sorting cards","T-chart mat","Sentence frame strip","Mini whiteboard"],"sc":["Picture-supported event cards","Bilingual card: theme and tema","Teacher models first sort card"],"df":{"b":"Sort with teacher guidance; draw and label response","o":"Sort all cards plus write sentence frame response","a":"Sort plus write theme plus explain why in 2 sentences","e":"ELP 1-2: pointing and drawing; ELP 3: frame; ELP 4-6: written"},"ms":["May mix theme with main idea - display side-by-side examples and non-examples"],"tp":"Draw a sequence of someone wasting food and facing a consequence. What mistake did they make?"}},
{"u":0,"w":3,"t":"How can an environment affect lives and relationships?","x":"Cocoliso","g":"Realistic Fiction","s":["3.5c - Compare and contrast characters","3.4 - Figurative language"],"c":"Character Analysis and Compare Contrast","vi":"Unit 1: Reading Fluency","p":{"co":"Compare and contrast two characters using text evidence.","lo":"Use: blank and blank are both blank, but blank is blank while blank is blank.","wd":{"ELP 1":"Sort picture cards of character traits into a Venn diagram","ELP 2":"Label Venn with word bank","ELP 3":"Write one similarity plus one difference with sentence starters","ELP 4":"Write a comparison paragraph with academic vocabulary","ELP 5-6":"Analyze how environment shapes each character differently with text evidence"},"v1":["friend","family","different","same"],"v2":["compare","contrast","character trait","relationship"],"v3":["characterization","textual evidence","inference"],"ac":"Venn Diagram Compare - Students add details via sticky notes to a class Venn.","mn":["Large Venn diagram anchor chart","Character trait word cards","Sticky notes (2 colors)","Sentence frame strips"],"sc":["Character trait word bank with pictures on desk","Color-coded sticky notes per character","Sentence frame on board"],"df":{"b":"Pre-filled Venn with 2 traits to sort; draw connection between characters","o":"Add 3 traits per circle plus write comparison sentence","a":"Write full paragraph comparing characters with 3 text details","e":"ELP 1-2: picture and word sort; ELP 3: sentence frame; ELP 4-6: paragraph"},"ms":["ELL students often compare only appearance not traits - model: This is how they LOOK vs how they ACT","Students may not know contrast - teach simply as find what is different"],"tp":"Have students tell a partner one way they are similar and one way they are different, then transfer that language into the Venn diagram frame."},"l":{"co":"Name one similarity and one difference between two characters.","lo":"Use: blank and blank are both blank and blank is blank but blank is blank.","wd":{"ELP 1":"Sort 4 picture cards into 2 character columns","ELP 2":"Add 1 word to each Venn section using word bank","ELP 3":"Write one similarity plus one difference with starters","ELP 4":"Write a 2-sentence comparison with vocabulary","ELP 5-6":"Use text evidence to explain how environment affects each character"},"v1":["same","different","friend"],"v2":["compare","contrast","character trait"],"v3":["inference"],"ac":"Mini Venn on individual whiteboards. Teacher guides first section; students complete second with a partner.","mn":["Mini whiteboard plus Venn template","Character picture cards","Sentence frame strips","4 character trait word cards"],"sc":["Teacher models first Venn entry together","Bilingual word bank on desk","Sentence stems on table tents"],"df":{"b":"Match picture cards to pre-written traits; draw one similarity","o":"Complete mini Venn plus write 2-sentence comparison","a":"Write paragraph plus connect to personal experience","e":"ELP 1-2: sort and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May only compare appearance - redirect: How do they ACT? Feel? What do they want?"],"tp":"Use two classroom objects, act out one similarity and one difference."}},
{"u":0,"w":4,"t":"What solutions do people find in their environment?","x":"Living in Deserts","g":"Informational Text","s":["3.6a - Main idea and key details","3.6b - Text features"],"c":"Main Idea and Text Features","vi":"Unit 1: Academic Vocabulary","p":{"co":"Identify the main idea and two key details using text features.","lo":"State: The main idea is blank and one key detail is blank.","wd":{"ELP 1":"Point to main idea from 3 picture choices; match one detail picture","ELP 2":"Fill in main idea plus 1 detail on graphic organizer with word bank","ELP 3":"Write main idea plus 2 key details with sentence starters","ELP 4":"Write a main idea statement with 3 supporting details","ELP 5-6":"Write a summary using main idea plus synthesized details in a paragraph"},"v1":["hot","sand","water","animal","plant"],"v2":["adapt","survive","solution","feature"],"v3":["main idea","key details","text structure"],"ac":"Text Feature Scavenger Hunt - Students use sticky flags to label 5 text features.","mn":["Sticky flags","Main idea and detail graphic organizer","Text feature reference card","Highlighter tape"],"sc":["Text feature anchor chart posted","Sentence frame for main idea","Vocab picture and definition cards","Pre-highlighted key details for ELP 1-2"],"df":{"b":"Pre-flagged text; fill in 1 blank on graphic organizer with word bank","o":"Flag 3 text features plus complete main idea graphic organizer","a":"Create a mini text-feature glossary; write a summary with main idea plus 3 details","e":"ELP 1-2: point and label; ELP 3: sentence frame; ELP 4-6: written summary"},"ms":["Students confuse main idea with topic or a single detail - use the umbrella visual","ELL students may focus on unfamiliar vocabulary and miss the overall message"],"tp":"Lay out 4 survival items: If you lived in a desert, why would you need these?"},"l":{"co":"Identify the main idea of one section of informational text.","lo":"Use: This section is mostly about blank.","wd":{"ELP 1":"Choose main idea from 2 picture options","ELP 2":"Fill in: This is mostly about blank (word bank)","ELP 3":"Write main idea plus 1 detail from a highlighted paragraph","ELP 4":"Write main idea plus 2 details; identify one text feature","ELP 5-6":"Summarize one section using main idea plus 3 details"},"v1":["hot","water","plant"],"v2":["adapt","survive","feature"],"v3":["main idea","text features"],"ac":"One-Paragraph Focus - Teacher selects one focused paragraph; students highlight and write the main idea.","mn":["Highlighted paragraph cutout","Main idea graphic organizer","Dry-erase markers","Sentence frame card"],"sc":["Teacher reads paragraph aloud together","Bilingual main idea vocabulary","Pre-underlined key detail"],"df":{"b":"Teacher scribes; student points to main idea picture from 2 choices","o":"Fill in graphic organizer with sentence frame","a":"Write main idea in own words plus explain why you chose it","e":"ELP 1-2: drawing and labeling; ELP 3: frame; ELP 4-6: written"},"ms":["Confuse one detail with the main idea - use the say it in 1 sentence test"],"tp":"Show the cover: From just this picture, what is MOST of this book about?"}},
{"u":0,"w":5,"t":"Why should we appreciate our environment?","x":"The Golden Flower","g":"Puerto Rican Myth","s":["3.5d - Author purpose","3.4 - Literary vocabulary"],"c":"Author Purpose and Cultural Connections","vi":"Unit 1: Speaking and Discussion","p":{"co":"Identify the author purpose and support with text evidence.","lo":"Explain: The author purpose is blank because blank.","wd":{"ELP 1":"Match purpose word to a picture example","ELP 2":"Circle author purpose from 3 choices; add one detail word","ELP 3":"Write author purpose plus 1 text evidence sentence","ELP 4":"Explain author purpose with 2 text details","ELP 5-6":"Analyze how cultural elements help achieve the author purpose"},"v1":["flower","water","sky","ground"],"v2":["author purpose","entertain","myth","cultural"],"v3":["narrative purpose","cultural heritage","origin story"],"ac":"Purpose Sort Gallery Walk - 3 stations: Inform, Persuade, Entertain.","mn":["Author Purpose anchor chart","Evidence strips","Sticky notes for justification","Gallery walk recording sheet"],"sc":["PIE chart reference card on desk","Evidence stems posted","Co-teacher supports gallery walk rotation","Bilingual glossary available"],"df":{"b":"Sort 2 evidence strips with teacher support; copy justification sentence","o":"Sort 3 strips; write own justification sentence","a":"Write paragraph defending chosen purpose with 2 pieces of evidence","e":"ELP 1-2: match and sort; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students think a text can only have one purpose - clarify: most texts have a primary and secondary purpose","ELL students may not know what a myth is - connect to origin stories from home cultures"],"tp":"Ask: Does anyone know a story about HOW something in nature was created?"},"l":{"co":"Identify whether the author purpose is to entertain, inform, or persuade.","lo":"Use: I think the author wrote this to blank because blank.","wd":{"ELP 1":"Point to purpose picture card","ELP 2":"Circle purpose plus copy sentence frame","ELP 3":"Write purpose plus 1 reason with starter","ELP 4":"Write purpose plus 2 reasons with vocabulary","ELP 5-6":"Explain and defend choice in a full paragraph"},"v1":["story","flower","water"],"v2":["author purpose","entertain","myth"],"v3":["origin story"],"ac":"Purpose Card Match - Match 4 text excerpt cards to Entertain, Inform, or Persuade mats.","mn":["3 purpose label mats","4 text excerpt cards","Dry-erase sentence frame card","Purpose word ring"],"sc":["Picture support on all purpose cards","Teacher models first card placement","Bilingual entertain vocabulary"],"df":{"b":"Match 2 cards with teacher; circle the purpose","o":"Match all 4 plus write sentence","a":"Match plus explain plus connect to another text they know","e":"ELP 1-2: match; ELP 3: frame; ELP 4-6: written"},"ms":["May confuse entertain with fun - clarify: entertain means tells a story, even a serious one"],"tp":"Hold up 3 book covers and name the purpose. Transfer that thinking to the myth."}},
{"u":1,"w":1,"t":"How do animals and plants need each other?","x":"Pollinators (Nat Geo)","g":"Informational Text","s":["3.6a - Main idea","3.6c - Compare and contrast"],"c":"Science Connections and Cause and Effect","vi":"Unit 2: Vocabulary Builder","p":{"co":"Explain how two living things interact and depend on each other.","lo":"Use: blank needs blank because blank and blank helps blank by blank.","wd":{"ELP 1":"Match animal and plant picture cards to show a connection","ELP 2":"Fill in: blank needs blank (word bank)","ELP 3":"Write one way two organisms interact with a sentence starter","ELP 4":"Explain two interactions using cause-and-effect language","ELP 5-6":"Write a paragraph comparing two interactions and their importance"},"v1":["bee","flower","seed","food","sun"],"v2":["pollinate","interact","depend","habitat","ecosystem"],"v3":["mutualism","interdependence","symbiosis"],"ac":"Interaction Web - Class creates a yarn web showing how organisms connect.","mn":["Organism picture cards","Yarn ball","Sentence frame strips","Cause and Effect graphic organizer"],"sc":["Bilingual depend vocabulary","Picture plus definition cards","Sentence frame posted","Pre-drawn connections for ELP 1-2"],"df":{"b":"Match 3 animal-plant pairs with picture support; copy 1 connection sentence","o":"Complete cause and effect chart with 2 interactions; write 2 sentences","a":"Write a paragraph explaining why one interaction is most important","e":"ELP 1-2: match and point; ELP 3: sentence frame; ELP 4-6: written"},"ms":["Students may think only animals need things - clarify: plants also have needs and give back","ELL students may not know pollinate - preview with a concrete picture walk"],"tp":"Show a jar of honey: How did this get made? Traces back to bees and flowers and pollination."},"l":{"co":"Identify one way two organisms depend on each other.","lo":"Use: blank helps blank by blank.","wd":{"ELP 1":"Point to the helper in a picture pair","ELP 2":"Fill in: blank helps blank (word bank)","ELP 3":"Write one interaction sentence with starter","ELP 4":"Explain one interaction plus why it matters","ELP 5-6":"Explain two interactions and compare them"},"v1":["bee","flower","food"],"v2":["pollinate","depend","habitat"],"v3":["mutualism"],"ac":"Partner Pairs - Each student gets one organism card and finds their partner.","mn":["Organism partner cards","Sentence frame strips","Mini whiteboard","Connection arrow cards"],"sc":["Teacher introduces pairs before activity","Bilingual organism names on cards","Choral reading of one key paragraph"],"df":{"b":"Pre-matched cards; copy sentence frame","o":"Write sentence plus draw the connection","a":"Write 2 sentences plus explain what would happen without this connection","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May think bees eat flowers - clarify: they collect nectar, not the flower itself"],"tp":"Bring a flower and a cotton swab. Demonstrate pollination before the lesson."}},
{"u":1,"w":2,"t":"How do animals adapt to interact with their world?","x":"Amazing Animal Adaptations","g":"Informational Text","s":["3.6b - Text features","3.6a - Main idea"],"c":"Science Vocabulary and Text Structure","vi":"Unit 2: Reading Fluency","p":{"co":"Explain what an adaptation is and describe two examples from the text.","lo":"Use: The blank is adapted to blank because blank.","wd":{"ELP 1":"Match animal picture to its adaptation","ELP 2":"Fill in graphic organizer: animal plus adaptation with word bank","ELP 3":"Write definition plus one example with sentence starter","ELP 4":"Explain two adaptations using academic vocabulary","ELP 5-6":"Compare two animal adaptations; argue which is most impressive with evidence"},"v1":["feet","wings","beak","skin","fur"],"v2":["adapt","survive","environment","structure"],"v3":["adaptation","natural selection","camouflage"],"ac":"Adaptation Gallery - 6 animal stations around the room.","mn":["Animal station cards with photos","Recording graphic organizer","Adaptation word cards","Sticky notes"],"sc":["Sentence frame at each station","Bilingual adapt vocabulary","Pre-completed example at station 1"],"df":{"b":"Visit 3 stations; use word bank to label adaptation","o":"Visit all 6; write adaptation plus reason for each","a":"Rank adaptations from most helpful to least helpful with justification","e":"ELP 1-2: label and point; ELP 3: sentence frame; ELP 4-6: comparison"},"ms":["Students think adaptations are choices - clarify: adaptations develop over many generations","Camouflage is often confused with hiding - it is a physical feature, not a behavior"],"tp":"Show a flounder blending into sand: Do you see anything unusual?"},"l":{"co":"Describe one animal adaptation with a reason.","lo":"Use: The blank helps the animal blank.","wd":{"ELP 1":"Match animal to 1 adaptation picture","ELP 2":"Fill in: The blank helps the animal blank (word bank)","ELP 3":"Write definition plus one example with starter","ELP 4":"Write two sentences about one animal adaptation","ELP 5-6":"Compare two animals; which has a better adaptation for survival and why?"},"v1":["feet","beak","fur"],"v2":["adapt","survive","environment"],"v3":["adaptation","camouflage"],"ac":"Sort and Write - Sort 6 animal cards into land, water, or air categories.","mn":["6 animal sort cards","3 habitat label mats","Sentence frame strip","Mini whiteboard"],"sc":["Teacher models one sort card","Bilingual environment vocabulary","Definition card: adaptation"],"df":{"b":"Sort into 2 categories only; accept drawing","o":"Sort all 3 plus write 1 sentence per group","a":"Write a short paragraph: My favorite adaptation is blank because blank","e":"ELP 1-2: sort and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May think all birds can swim - use specific examples to show variation across species"],"tp":"Before sorting, ask: If you could have any animal adaptation, which would you choose?"}},
{"u":1,"w":3,"t":"How do communities of living things work together?","x":"The Secret Life of the Forest","g":"Literary Nonfiction","s":["3.6a - Main idea","3.5b - Author craft"],"c":"Literary Nonfiction and Author Purpose","vi":"Unit 2: Academic Vocabulary","p":{"co":"Identify how literary nonfiction uses story elements to convey factual information.","lo":"Explain: The author includes blank to help the reader blank.","wd":{"ELP 1":"Sort 4 sentences as fact or story on a T-chart","ELP 2":"Label 2 story elements plus 2 facts with word bank","ELP 3":"Write one example of how the author uses story language to explain a fact","ELP 4":"Explain author craft with two specific text examples","ELP 5-6":"Evaluate: is this an effective way to present information?"},"v1":["tree","roots","soil","light","water"],"v2":["literary nonfiction","craft","communicate","community"],"v3":["genre characteristics","author craft","informational narrative"],"ac":"Fact vs Story Chart - Students sort text excerpts into Factual information and Story language.","mn":["Text excerpt cards","Two-column sort mat","Sentence frame card","Anchor chart: Literary Nonfiction"],"sc":["Pre-sorted first 2 cards as model examples","Bilingual fact vocabulary","Discussion frames for partner talk"],"df":{"b":"Sort 4 cards with teacher support; copy one explanation sentence","o":"Sort all 10 cards; write 2 sentences about author craft","a":"Write a paragraph evaluating which genre feature is most effective","e":"ELP 1-2: sort and label; ELP 3: sentence frame; ELP 4-6: paragraph"},"ms":["Students may think literary nonfiction is made up - ALL information is factual","ELL students may struggle with figurative language in nonfiction"],"tp":"Hold up a textbook page and the anchor text. Which is more interesting to read?"},"l":{"co":"Identify one way the author uses story language in an informational text.","lo":"Use: The author uses blank to make the reader feel blank.","wd":{"ELP 1":"Circle story word in a highlighted sentence","ELP 2":"Fill in: The author uses blank because blank (word bank)","ELP 3":"Write one example with sentence starter","ELP 4":"Explain one craft choice with 2 sentences","ELP 5-6":"Evaluate: does this craft choice help you understand the topic better?"},"v1":["tree","roots","water"],"v2":["literary nonfiction","craft","community"],"v3":["genre","informational narrative"],"ac":"Story vs Fact Duo - Teacher reads one paragraph aloud and students underline story and fact language.","mn":["Paragraph cutout","Yellow and blue highlighters","Sentence frame card","Anchor chart reference"],"sc":["Teacher models with first sentence","Bilingual fact and story vocabulary","Pre-highlighted example"],"df":{"b":"Teacher highlights; student traces and copies sentence frame","o":"Highlight 2 of each type plus write sentence about craft","a":"Write 3 sentences: what, why, and own opinion of this style","e":"ELP 1-2: circle and label; ELP 3: frame; ELP 4-6: written evaluation"},"ms":["May think anything pretty sounding is not factual - nonfiction can use beautiful language AND still be true"],"tp":"Read one vivid sentence with expression, then a plain textbook version of the same fact."}},
{"u":1,"w":4,"t":"What happens when environments change?","x":"Wolves of Yellowstone","g":"Informational Text","s":["3.6d - Cause and effect","3.4 - Domain-specific vocabulary"],"c":"Cause and Effect and Text Structures","vi":"Unit 2: Speaking and Discussion","p":{"co":"Explain how one environmental change causes multiple effects using text evidence.","lo":"Use: Because blank, blank happened. This caused blank.","wd":{"ELP 1":"Match cause picture to effect picture","ELP 2":"Fill in: Because blank, blank (word bank)","ELP 3":"Write one cause plus two effects with sentence starters","ELP 4":"Explain a chain of effects using academic vocabulary","ELP 5-6":"Analyze how removing one species causes a cascade; cite 3 text details"},"v1":["wolf","deer","river","grass","hunt"],"v2":["cause","effect","ecosystem","balance","predator"],"v3":["trophic cascade","biodiversity","ecological balance"],"ac":"Cause-and-Effect Chain - Class builds a domino chain showing how wolves returning caused change.","mn":["Cause and Effect graphic organizer","Sticky notes for chain effects","Domino visual cut-outs","Word wall"],"sc":["Cause and Effect sentence frame on board","Pre-filled cause box","Bilingual cause and effect vocabulary"],"df":{"b":"Pre-filled cause; student writes or draws 1 effect","o":"Complete 3-step chain; write 2 cause and effect sentences","a":"Write a paragraph explaining the full trophic cascade","e":"ELP 1-2: picture match and label; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students often identify only ONE effect - model: And then THAT caused blank","May confuse cause with effect - anchor: cause equals WHY, effect equals WHAT happened next"],"tp":"Stack 5 dominoes and knock them down. What was the first? What was the last result?"},"l":{"co":"Identify one cause and one effect from an informational text.","lo":"Use: Because blank, blank.","wd":{"ELP 1":"Point to the cause in a picture pair","ELP 2":"Fill in: Because blank, blank (word bank)","ELP 3":"Write cause plus effect with sentence starter","ELP 4":"Write a 2-sentence cause and effect explanation","ELP 5-6":"Write 3 connected cause and effect statements forming a chain"},"v1":["wolf","deer","river"],"v2":["cause","effect","predator"],"v3":["ecosystem"],"ac":"Mini Cause and Effect Chain - 3-box chain where students fill in middle and final effect.","mn":["3-box chain graphic organizer","Cause and Effect word cards","Sentence frame card","Mini whiteboard"],"sc":["Teacher fills in first box together","Bilingual cause vocabulary","Picture support in each box"],"df":{"b":"Teacher fills 2 boxes; student adds 1 drawing or word","o":"Complete all 3 plus write 1 sentence","a":"Add a 4th box: I predict next blank because blank","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May flip cause and effect - practice: FIRST this happened, THEN this happened"],"tp":"Show a before-and-after photo of Yellowstone. What do you think changed?"}},
{"u":1,"w":5,"t":"How do humans interact with and change environments?","x":"Everglades: Buffalo Tiger","g":"Biography and Nonfiction","s":["3.6e - Summarize informational text","3.4 - Author word choice"],"c":"Summarizing and Perspectives","vi":"Unit 2: Grammar in Context","p":{"co":"Summarize how a person's actions impacted an environment.","lo":"Summarize using: First blank, then blank, as a result blank.","wd":{"ELP 1":"Sequence 3 event pictures from the text in order","ELP 2":"Fill in 3-box summary graphic organizer (word bank)","ELP 3":"Write a 3-sentence summary using sentence starters","ELP 4":"Write a 4-5 sentence summary with academic vocabulary","ELP 5-6":"Write a summary paragraph including point of view and lasting impact"},"v1":["river","grass","protect","people","land"],"v2":["summarize","impact","preserve","environment","perspective"],"v3":["conservation","advocacy","historical context"],"ac":"Summary Shrink - Students shrink 10 events down to 3, then write a 3-sentence summary.","mn":["10 event strips","Shrink funnel graphic organizer","Summary frame card","Highlighters"],"sc":["Summary sentence frames posted","Pre-highlighted 5 key events for ELP 1-2","Bilingual summarize vocabulary"],"df":{"b":"Start with 5 events; shrink to 3; use sentence frame","o":"Shrink from 10 to 5 to 3; write 3-sentence summary","a":"Write a 5-sentence summary including perspective and lasting impact","e":"ELP 1-2: sequence pictures; ELP 3: frame; ELP 4-6: full paragraph"},"ms":["Students include too many details - reinforce: Would the story make sense without this?","ELL students may copy sentences directly - model paraphrasing"],"tp":"Have students summarize their morning routine in exactly 3 sentences."},"l":{"co":"Retell 3 key events from an informational text in order.","lo":"Use: First blank, next blank, finally blank.","wd":{"ELP 1":"Sequence 3 event pictures in correct order","ELP 2":"Fill in: First blank, next blank, finally blank (word bank)","ELP 3":"Write 3-sentence retelling with sentence starters","ELP 4":"Write a 3-4 sentence summary with key vocabulary","ELP 5-6":"Write a summary plus one sentence about lasting impact"},"v1":["river","protect","people"],"v2":["summarize","preserve","impact"],"v3":["conservation"],"ac":"3-Event Strip - Each student sequences 3 random event strips and writes a sentence for each.","mn":["3 event strips","Sequencing mat","Sentence frame card","Mini whiteboard"],"sc":["Teacher previews pictures before sequencing","Bilingual first vocabulary","Choral reading of each card"],"df":{"b":"2 strips plus teacher support; draw the 3rd event","o":"Sequence all 3 plus write 3 sentences","a":"Sequence plus write 3 sentences plus explain which was most important","e":"ELP 1-2: sequence and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May retell events out of order in writing even when physically sequenced"],"tp":"Give 3 random strips from a familiar story as a warm-up sequencing task."}},
{"u":2,"w":1,"t":"What qualities make a person brave?","x":"Elena's Serenade","g":"Fantasy Fiction","s":["3.5a - Character traits and evidence","3.5e - Story structure"],"c":"Character Development and Inference","vi":"Unit 3: Vocabulary Builder","p":{"co":"Identify two character traits and support each with text evidence.","lo":"Use: I can tell blank is blank because in the story blank.","wd":{"ELP 1":"Match character trait word to a picture of the character acting that way","ELP 2":"Fill in: The character is blank because blank (word bank)","ELP 3":"Write 2 character traits plus 1 piece of text evidence for each","ELP 4":"Write a character analysis with two traits and supporting evidence","ELP 5-6":"Explain how two traits help the character overcome the main conflict"},"v1":["brave","kind","strong","helper","hope"],"v2":["character trait","evidence","determination","courage"],"v3":["characterization","textual evidence","implicit vs explicit"],"ac":"Trait Evidence T-Chart - Students write a trait and matching text evidence.","mn":["T-Chart graphic organizer","Character trait word wall cards","Sticky note evidence flags","Sentence frame strip"],"sc":["Character trait word bank with pictures","Pre-bookmarked evidence pages","Sentence frame posted on board"],"df":{"b":"Pre-written trait; student finds and draws evidence with support","o":"Write 2 traits plus evidence from text","a":"Write a paragraph: how do the character traits help them be a hero?","e":"ELP 1-2: match and label; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students describe physical appearance instead of personality traits","Students may identify a feeling rather than a trait"],"tp":"Ask: Think of one person in your life who is brave. What do they DO that shows it?"},"l":{"co":"Identify one character trait and find one piece of evidence.","lo":"Use: I think blank is blank because blank.","wd":{"ELP 1":"Point to a picture showing bravery, kindness, or determination","ELP 2":"Fill in trait plus circle evidence page (word bank)","ELP 3":"Write trait plus evidence sentence with starter","ELP 4":"Write 2 sentences: trait plus evidence plus explain","ELP 5-6":"Write a 3-sentence character analysis"},"v1":["brave","kind","hope"],"v2":["character trait","evidence","determination"],"v3":["characterization"],"ac":"Mini T-Chart - One trait, one piece of evidence, modeled then done independently.","mn":["Mini T-chart template","5 character trait picture cards","Sticky note evidence marker","Sentence frame strip"],"sc":["Teacher models with one complete example","Pre-bookmarked key page","Bilingual brave vocabulary"],"df":{"b":"Teacher writes the trait; student draws and points to evidence","o":"Complete mini T-chart plus write sentence using frame","a":"Write 2 traits plus 2 evidences plus connect to personal definition of hero","e":"ELP 1-2: match and point; ELP 3: frame; ELP 4-6: written"},"ms":["May think brave means not being scared - clarify: bravery is acting despite being scared"],"tp":"Quick show of hands: Have you ever done something scary because you knew it was right?"}},
{"u":2,"w":2,"t":"Can everyday people be heroes?","x":"Harvesting Hope: Cesar Chavez","g":"Biography","s":["3.6f - Biography features","3.5d - Author purpose"],"c":"Biography and Historical Thinking","vi":"Unit 3: Listening and Speaking","p":{"co":"Explain how a real person demonstrated heroic qualities using text evidence.","lo":"Use: blank showed blank by doing blank. This is important because blank.","wd":{"ELP 1":"Point to 2 pictures showing the person's heroic actions","ELP 2":"Fill in: blank helped people by blank (word bank)","ELP 3":"Write one heroic action plus one reason it matters","ELP 4":"Explain two heroic actions using biography vocabulary","ELP 5-6":"Compare this biography subject to the fictional hero from Week 1"},"v1":["farm","work","march","rights","family"],"v2":["biography","persevere","advocate","injustice","dignity"],"v3":["civil rights","labor movement","historical context"],"ac":"Hero Profile Card - Students create a card with name, trait, action, quote, and why it matters.","mn":["Hero Profile card template","Biography vocabulary cards","Text excerpt strips","Sentence frames for each section"],"sc":["Sentence frame for each profile section","Bilingual rights and justice vocabulary","Pre-selected text excerpts"],"df":{"b":"Fill in 2 sections with word bank; draw one action","o":"Complete all 5 sections; write in own words","a":"Compare Hero Profile to fictional hero from Week 1","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students may think heroes must do big famous things","Biography is often mistaken for fiction"],"tp":"Ask: Have you ever stood up for something you believed in, even when it was hard?"},"l":{"co":"Identify one action this person took and explain why it was heroic.","lo":"Use: blank helped people by blank.","wd":{"ELP 1":"Point to an action picture; choose hero or not hero","ELP 2":"Fill in: blank helped people by blank (word bank)","ELP 3":"Write one action plus one reason it was heroic","ELP 4":"Write 3 sentences about this person's heroism","ELP 5-6":"Write a short paragraph including an opinion about lasting impact"},"v1":["farm","march","help"],"v2":["biography","persevere","rights"],"v3":["civil rights","advocate"],"ac":"Action-Impact Match - Match action cards to impact cards and write about the most important match.","mn":["4 action cards","4 impact cards","Matching mat","Sentence frame strip"],"sc":["Teacher previews each action card","Bilingual action vocabulary","Model sentence provided"],"df":{"b":"Match 2 pairs with support; copy sentence","o":"Match all 4 plus write 1 sentence","a":"Match plus write 2 sentences plus give your opinion","e":"ELP 1-2: match and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May not understand rights - use: things everyone deserves, like food, safety, and fair pay"],"tp":"Show a photo of farm workers in the 1960s with no explanation."}},
{"u":2,"w":3,"t":"How do heroes face challenges?","x":"The One and Only Ivan","g":"Realistic Fiction","s":["3.5c - Plot development and conflict","3.5b - Theme"],"c":"Conflict and Resolution and Theme","vi":"Unit 3: Reading Fluency","p":{"co":"Identify the main conflict and explain how the character responds to challenges.","lo":"Use: The conflict is blank because blank. The character responds by doing blank.","wd":{"ELP 1":"Point to pictures showing the problem and the response","ELP 2":"Fill in conflict and resolution T-chart (word bank)","ELP 3":"Write the conflict plus character response with starters","ELP 4":"Explain conflict plus response plus what it reveals about character","ELP 5-6":"Analyze how the conflict develops the theme; cite 2 pieces of evidence"},"v1":["problem","sad","help","friend","free"],"v2":["conflict","resolution","challenge","respond","persist"],"v3":["internal and external conflict","plot development","theme inference"],"ac":"Conflict Map - Students identify conflict type, what happens, response, and resolution.","mn":["Conflict Map graphic organizer","3 conflict type cards","Sentence frames for each section"],"sc":["Conflict type anchor chart with picture examples","Sentence starters for each section","Co-teacher think-aloud on first entry"],"df":{"b":"Pre-filled type plus what happens; student writes response","o":"Complete conflict map; write 2 sentences connecting conflict to theme","a":"Write paragraph: how does this conflict develop the theme?","e":"ELP 1-2: picture and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students identify any bad thing as the conflict","ELL students may not know conflict as a term"],"tp":"Ask: Have you ever wanted something really badly but something kept getting in the way?"},"l":{"co":"Describe the main problem and one thing the character did about it.","lo":"Use: The problem is blank. The character did blank because blank.","wd":{"ELP 1":"Choose the main problem from 2 picture options","ELP 2":"Fill in: The problem is blank, the character blank (word bank)","ELP 3":"Write problem plus character response with starter","ELP 4":"Write 2 sentences: problem, response, result","ELP 5-6":"Write 3 sentences: conflict, response, what it reveals about character"},"v1":["problem","help","free"],"v2":["conflict","challenge","respond"],"v3":["resolution"],"ac":"Problem and Response Mini Map - 2-box organizer completed with teacher then independently.","mn":["2-box graphic organizer","Problem picture cards","Sentence frame strips","Mini whiteboard"],"sc":["Teacher reads key conflict passage aloud","Pre-filled problem box for ELP 1","Bilingual problem vocabulary"],"df":{"b":"Fill in response box only; draw the problem","o":"Complete both boxes plus write 1 sentence","a":"Add a 3rd box: What I would have done differently","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May describe a single event, not the main conflict"],"tp":"Act out a quick skit: student wants to go outside but it is raining. Connect to the text."}},
{"u":2,"w":4,"t":"How do heroes inspire others?","x":"Malala's Magic Pencil","g":"Autobiography","s":["3.6f - Author point of view","3.6a - Main idea"],"c":"Author Voice and Point of View","vi":"Unit 3: Academic Vocabulary","p":{"co":"Identify the author point of view and explain how it shapes the text.","lo":"Use: The author believes blank because she writes blank.","wd":{"ELP 1":"Circle I, me, and my to identify first person","ELP 2":"Fill in: The author believes blank (word bank)","ELP 3":"Write the author point of view plus 1 specific text example","ELP 4":"Explain point of view plus 2 text examples","ELP 5-6":"Analyze how first-person POV makes the message more or less powerful"},"v1":["school","read","write","dream","speak"],"v2":["point of view","perspective","first-person","believe","inspire"],"v3":["autobiography","authorial perspective","narrative voice"],"ac":"POV Detective - Students find sentences that reveal Malala's belief and annotate them.","mn":["Text excerpt cards","Sticky notes for annotation","POV graphic organizer","Sentence frame strip"],"sc":["Anchor chart of first person clue words","Pre-selected excerpts for ELP 1-2","Bilingual believe vocabulary"],"df":{"b":"Choose 1 sentence from 2 options; copy POV sentence frame","o":"Find 3 examples; write POV sentence","a":"Write a paragraph: how does first-person POV affect how you read the text?","e":"ELP 1-2: circle clue words; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students confuse point of view with narrator","ELL students may not know autobiography vs biography"],"tp":"Have students write: I believe blank. Share and connect to Malala's POV."},"l":{"co":"Identify who is telling the story and one thing the author believes.","lo":"Use: The author is blank and she believes blank.","wd":{"ELP 1":"Circle I and me in one paragraph","ELP 2":"Fill in: The author believes blank (word bank)","ELP 3":"Write who is telling the story plus what they believe","ELP 4":"Write 2 sentences: narrator plus belief plus evidence","ELP 5-6":"Explain how this POV affects the overall message"},"v1":["school","read","dream"],"v2":["point of view","first-person","believe"],"v3":["autobiography"],"ac":"I Believe Sticky - Find one belief sentence and write why she believes it.","mn":["Text excerpt","Sticky notes","Sentence frame strip","Highlighter"],"sc":["Teacher reads paragraph aloud together","Pre-highlighted clue sentence","Bilingual first-person vocabulary"],"df":{"b":"Circle pre-highlighted sentence; copy sentence frame","o":"Find sentence independently plus write 2-part sticky note","a":"Write 2 beliefs plus explain which is most important to her message","e":"ELP 1-2: circle and copy; ELP 3: frame; ELP 4-6: written"},"ms":["May confuse first-person telling with making things up"],"tp":"Show the book cover: How would this story be DIFFERENT if someone ELSE wrote it?"}},
{"u":2,"w":5,"t":"What can we learn from heroes past and present?","x":"Two-Text Hero Comparison","g":"Biography and Informational","s":["3.6c - Compare and contrast two texts","3.4 - Synthesize"],"c":"Synthesis and Compare Across Texts","vi":"Unit 3: Grammar in Context","p":{"co":"Compare how two texts present heroism using key details from each.","lo":"Use: Both texts show blank, but blank shows it by doing blank while blank shows it by doing blank.","wd":{"ELP 1":"Match picture clues from each text that show similar or different qualities","ELP 2":"Fill in Venn diagram (word bank)","ELP 3":"Write one similarity plus one difference with starters","ELP 4":"Write a comparison sentence per Venn section","ELP 5-6":"Write a paragraph synthesizing both texts' portrayals of heroism"},"v1":["both","same","different","compare","text"],"v2":["synthesize","portray","perspective","heroism","contribute"],"v3":["textual synthesis","cross-text comparison","thematic connection"],"ac":"Two-Text Venn Diagram - Large class Venn built from sticky notes from both texts.","mn":["Large Venn diagram anchor chart","Sticky notes","Synthesis sentence frame","Text excerpt strips from both texts"],"sc":["Sentence frames for all 3 Venn sections","Pre-sorted examples to model","Bilingual compare vocabulary"],"df":{"b":"Fill in 2 sticky notes with word bank; copy synthesis sentence","o":"Add 3 sticky notes per text; write synthesis sentence","a":"Write a full paragraph synthesizing both texts' definitions of heroism","e":"ELP 1-2: match and sort; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students compare surface details instead of heroic qualities","ELL students may focus on only one text"],"tp":"Ask: If these two heroes could meet, what would they say to each other?"},"l":{"co":"Name one way two texts about heroes are the same.","lo":"Use: Both blank and blank showed blank.","wd":{"ELP 1":"Match one picture from each text showing the same quality","ELP 2":"Fill in: Both blank and blank (word bank)","ELP 3":"Write one similarity sentence with starter","ELP 4":"Write similarity plus one difference","ELP 5-6":"Write a 3-sentence comparison paragraph"},"v1":["both","same","hero"],"v2":["compare","heroism","similar"],"v3":["synthesis"],"ac":"Match It Up - Students find the card pair showing the same heroic quality across texts.","mn":["Hero quality match cards","Sentence frame strip","Mini whiteboard","Recording sheet"],"sc":["Teacher models one complete match","Bilingual same and both vocabulary","Picture support on all cards"],"df":{"b":"Match 2 pairs with support; copy one sentence","o":"Match 4 pairs plus write 2 sentences","a":"Match plus write paragraph about the most important shared quality","e":"ELP 1-2: match and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May list only differences instead of similarities"],"tp":"Ask each student to name 1 quality all heroes share before reading."}},
{"u":3,"w":1,"t":"What makes a moment in history important?","x":"Planting Stories: Pura Belpre","g":"Biography","s":["3.6f - Biography features","3.6e - Summarize"],"c":"Historical Significance and Summarizing","vi":"Unit 4: Vocabulary Builder","p":{"co":"Explain why a historical person's actions were significant.","lo":"Use: blank was important because blank. Without blank, blank.","wd":{"ELP 1":"Sequence 3 event pictures from the biography in order","ELP 2":"Fill in: This was important because blank (word bank)","ELP 3":"Write one significant action plus reason with sentence starter","ELP 4":"Explain two significant actions plus why they matter","ELP 5-6":"Argue why this person's contribution was most significant; cite 2 text details"},"v1":["library","book","story","language","share"],"v2":["significance","contribution","culture","preservation","community"],"v3":["historical context","cultural preservation","legacy"],"ac":"Significance Ladder - Students rank 4 events from this biography and justify their top choice.","mn":["Significance ladder graphic organizer","4 event summary strips","Sentence frame strip","Ranking dot stickers"],"sc":["Sentence frame for justification","Bilingual important vocabulary","Pre-ranked examples for ELP 1-2"],"df":{"b":"Rank top 2 events; circle the most important; copy justification","o":"Rank all 4 events; write justification for top choice","a":"Write paragraph: how does this person's legacy still affect us today?","e":"ELP 1-2: sequence and label; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students may say everything is important","ELL students may feel their cultures are underrepresented - validate and connect"],"tp":"Ask: What is one book or story from your home culture you want others to know about?"},"l":{"co":"Describe one important action from a biography and explain why it mattered.","lo":"Use: blank was important because blank.","wd":{"ELP 1":"Choose the most important action from 2 picture options","ELP 2":"Fill in: blank was important because blank (word bank)","ELP 3":"Write one action plus reason with starter","ELP 4":"Write 2 sentences: action plus why it matters plus who it helped","ELP 5-6":"Write 3 sentences plus opinion: I think this matters most because blank"},"v1":["library","story","share"],"v2":["important","contribute","culture"],"v3":["significance","legacy"],"ac":"Important or Not - Sort 4 event cards by whether they changed things for many or only one person.","mn":["4 event cards","Two-column sort mat","Sentence frame strip","Mini whiteboard"],"sc":["Teacher reads each card aloud","Bilingual important vocabulary","Picture support on event cards"],"df":{"b":"Sort 2 cards with teacher; copy sentence","o":"Sort all 4 plus write 1 sentence","a":"Write 2 sentences plus personal connection","e":"ELP 1-2: sort and point; ELP 3: frame; ELP 4-6: written"},"ms":["May think significance equals famous - redirect: significant equals changed things for others"],"tp":"Show a local library photo: Who goes here? Who does it serve?"}},
{"u":3,"w":2,"t":"How do natural events change communities?","x":"Hurricanes","g":"Informational Text","s":["3.6d - Cause and effect","3.6b - Text features"],"c":"Science plus ELA and Cause and Effect","vi":"Unit 4: Listening and Speaking","p":{"co":"Explain how a natural event causes multiple effects on a community.","lo":"Use: When a hurricane occurs, blank which causes blank.","wd":{"ELP 1":"Match cause and effect picture pairs","ELP 2":"Fill in: When blank, blank (word bank)","ELP 3":"Write 2 cause and effect pairs with starters","ELP 4":"Write a paragraph explaining the chain of effects from a hurricane","ELP 5-6":"Compare effects of one natural event vs another using both texts"},"v1":["wind","rain","water","home","flood"],"v2":["cause","effect","severe","damage","recover"],"v3":["meteorology","infrastructure","disaster recovery"],"ac":"Hurricane Effect Chain - Students build a 4-link cause and effect chain.","mn":["4-link chain graphic organizer","Cause and effect vocabulary cards","Text evidence flags","Effect domino cut-outs"],"sc":["Pre-filled link 1 (cause)","Sentence frame: This causes blank","Bilingual cause and effect vocabulary"],"df":{"b":"Fill in links 3 and 4 with word bank support","o":"Complete the full 4-link chain; write 2 sentences","a":"Write an extended chain including community recovery","e":"ELP 1-2: match pictures; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students confuse conditions with causes","ELL students may have personal experience with hurricanes"],"tp":"Ask if any students have personal experience with a severe storm."},"l":{"co":"Identify one cause and one effect of a natural event.","lo":"Use: Because of blank, blank.","wd":{"ELP 1":"Point to cause and effect in a picture pair","ELP 2":"Fill in: Because of blank, blank (word bank)","ELP 3":"Write cause plus effect with starter","ELP 4":"Write 2 cause and effect pairs with vocabulary","ELP 5-6":"Write a short paragraph explaining 3 effects"},"v1":["wind","flood","home"],"v2":["cause","effect","damage"],"v3":["natural disaster"],"ac":"Cause and Effect Flip Book - 2-flap book with cause and effect drawn and written.","mn":["Flip book template","Cause and Effect word cards","Crayons","Sentence frame strip"],"sc":["Teacher fills in cause flap together","Bilingual because vocabulary","Draw first, then write"],"df":{"b":"Draw both sides; label with 1 word each","o":"Draw plus write complete sentence for each flap","a":"Make 2 flip books plus write a connecting sentence","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May reverse cause and effect order"],"tp":"Ask students to notice what a gentle breeze does, then imagine it 100 times stronger."}},
{"u":3,"w":3,"t":"How do people respond to challenging events?","x":"The Unbreakable Code","g":"Historical Fiction","s":["3.5a - Character response to events","3.5c - Historical fiction features"],"c":"Historical Fiction and Character Development","vi":"Unit 4: Reading Fluency","p":{"co":"Analyze how a character responds to a challenge and what it reveals about them.","lo":"Use: When blank happened, the character did blank. This shows that blank.","wd":{"ELP 1":"Match character action to a challenge picture","ELP 2":"Fill in: When blank, the character blank (word bank)","ELP 3":"Write challenge plus response with starters","ELP 4":"Write character analysis: challenge, response, and what it reveals","ELP 5-6":"Evaluate: does the character response make them a hero?"},"v1":["grandfather","code","secret","brave","language"],"v2":["challenge","respond","resilience","culture","identity"],"v3":["historical fiction","cultural identity","resistance"],"ac":"Challenge Response Reveals Chart - 3-column chart tracking challenge, response, and reveal.","mn":["3-column chart graphic organizer","Sticky note text evidence markers","Sentence frames for each column"],"sc":["Pre-filled column 1 for ELP 1-2","Sentence frames for all 3 columns","Bilingual challenge vocabulary"],"df":{"b":"Fill in columns 2 and 3 with word bank","o":"Complete all 3 columns with text evidence","a":"Write a paragraph evaluating whether the response makes them a hero","e":"ELP 1-2: match and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students describe what happened instead of how the character responded"],"tp":"Ask: Has your language or culture ever felt like a secret strength?"},"l":{"co":"Describe one challenge a character faces and how they respond.","lo":"Use: The character faced blank and responded by doing blank.","wd":{"ELP 1":"Point to: What is the challenge? (picture)","ELP 2":"Fill in: The character faced blank and blank (word bank)","ELP 3":"Write challenge plus response with starter","ELP 4":"Write 2 sentences: challenge, response, what it shows","ELP 5-6":"Write 3 sentences including what this reveals about character"},"v1":["brave","secret","language"],"v2":["challenge","respond","identity"],"v3":["resilience"],"ac":"Challenge and Response Duo - 2-box organizer completed with teacher then independently.","mn":["2-box graphic organizer","4 challenge picture cards","Sentence frame strip","Mini whiteboard"],"sc":["Teacher reads key passage aloud","Pre-drawn challenge picture for ELP 1","Bilingual respond vocabulary"],"df":{"b":"Draw response plus label 1 word","o":"Write 2 sentences (challenge and response)","a":"Add box 3: This reveals blank","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May confuse character feelings with their response"],"tp":"Give each student a scenario card and ask what they would do."}},
{"u":3,"w":4,"t":"How do celebrations connect us to history?","x":"Fiesta!","g":"Informational Text","s":["3.6a - Main idea","3.6e - Summarize"],"c":"Cultural Celebrations and Informational Writing","vi":"Unit 4: Academic Vocabulary","p":{"co":"Summarize why a cultural celebration is historically significant.","lo":"Use: blank is celebrated because blank. It connects people to blank by doing blank.","wd":{"ELP 1":"Match celebration to its country and culture on a reference map","ELP 2":"Fill in: blank is celebrated because blank (word bank)","ELP 3":"Write main idea of celebration plus one supporting detail","ELP 4":"Write a 3-4 sentence summary of celebration plus historical significance","ELP 5-6":"Compare two cultural celebrations and how they connect communities to history"},"v1":["celebrate","food","dance","family","tradition"],"v2":["culture","tradition","historical","significance","community"],"v3":["cultural heritage","collective memory","diaspora"],"ac":"Celebration Profile - Students create a card covering name, culture, origin, and significance.","mn":["Celebration Profile card template","World map reference","Cultural celebration picture cards","Sentence frames for each section"],"sc":["Sentence frame for each section","Pre-labeled world map","Bilingual vocabulary list"],"df":{"b":"Fill in 3 sections with word bank plus draw one tradition","o":"Complete full profile card; write in own words","a":"Write a paragraph connecting your own family celebration to collective memory","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students may think celebrations are just parties","ELL students may feel their celebrations are exotic - normalize all traditions"],"tp":"Ask each student to name one food or song from a family celebration."},"l":{"co":"Identify one reason a cultural celebration is important.","lo":"Use: blank is important because blank.","wd":{"ELP 1":"Point to a celebration picture; say or point to its name","ELP 2":"Fill in: blank is celebrated because blank (word bank)","ELP 3":"Write one reason plus one tradition with starter","ELP 4":"Write 2 sentences about celebration plus why it matters","ELP 5-6":"Write 3 sentences plus personal connection"},"v1":["celebrate","family","tradition"],"v2":["culture","community","historical"],"v3":["heritage","significance"],"ac":"Celebration Card - Fill in name, one thing people do, one reason it matters, and draw one tradition.","mn":["Celebration card template","3 picture choices per celebration","Sentence frame strip","Crayons"],"sc":["Teacher reads text excerpt aloud","Pre-written name plus one tradition","Bilingual tradition vocabulary"],"df":{"b":"Draw plus label; teacher scribes the sentence","o":"Write 2 complete sentences plus draw one tradition","a":"Write 3 sentences plus compare to own family celebration","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May not know how to spell celebration names - accept phonetic spelling"],"tp":"Bring in a small item connected to any celebration as a sensory hook."}},
{"u":3,"w":5,"t":"How do small moments become important events?","x":"Thunder Cake","g":"Realistic Fiction","s":["3.5a - Story elements","3.5b - Theme"],"c":"Theme and Personal Narrative Connections","vi":"Unit 4: Grammar in Context","p":{"co":"Explain how a small, ordinary moment can have a lasting, meaningful impact.","lo":"Use: Although blank seems small, it is important because blank.","wd":{"ELP 1":"Sequence 3 story event pictures in correct order","ELP 2":"Fill in: This moment was important because blank (word bank)","ELP 3":"Write one small moment plus why it mattered with starter","ELP 4":"Explain theme: what does this story teach about small moments?","ELP 5-6":"Connect theme to personal experience: Like in the story, I learned blank"},"v1":["storm","cake","scared","brave","together"],"v2":["theme","significance","moment","impact","memory"],"v3":["thematic statement","narrative significance","sensory detail"],"ac":"Small Moment Map - Students map the 5 senses connected to one small moment and write a theme statement.","mn":["5-senses graphic organizer","Theme statement frame","Sticky note evidence flags","Crayons"],"sc":["Sentence frame for theme statement","5-senses chart with bilingual labels","Completed example for ELP 1-2"],"df":{"b":"Fill in 2 senses plus copy the theme sentence","o":"Complete all 5 senses plus write theme statement","a":"Write a paragraph connecting this moment to a theme about courage or memory","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students may think only big events can have themes"],"tp":"Ask students to think of a small moment with a family member they will always remember."},"l":{"co":"Identify one important small moment in the story and explain why it mattered.","lo":"Use: blank was important because blank.","wd":{"ELP 1":"Choose the most important moment from 2 pictures","ELP 2":"Fill in: blank was important because blank (word bank)","ELP 3":"Write moment plus reason with starter","ELP 4":"Write 2 sentences plus connect to theme","ELP 5-6":"Write 3 sentences plus personal connection"},"v1":["storm","cake","brave"],"v2":["moment","important","memory"],"v3":["theme","significance"],"ac":"Moment plus Why Mat - Draw the small moment in box 1 and write why it mattered in box 2.","mn":["2-box graphic organizer","Story moment picture cards","Sentence frame strip","Crayons"],"sc":["Teacher previews key moment together","Picture support pre-added to box 1","Bilingual memory vocabulary"],"df":{"b":"Draw in both boxes; teacher scribes words","o":"Draw plus write sentences in both boxes","a":"Add a 3rd box: This reminds me of blank","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["Students write a summary instead of one moment"],"tp":"Ask everyone to close their eyes and recall one smell or sound from a special memory."}},
{"u":4,"w":1,"t":"How do people identify and solve problems?","x":"What Do You Do With a Problem?","g":"Literary Nonfiction and Fable","s":["3.5b - Theme","3.5a - Character motivation"],"c":"Growth Mindset and Theme","vi":"Unit 5: Vocabulary Builder","p":{"co":"Identify the theme and explain how the character's thinking changed throughout the story.","lo":"Use: At first the character thought blank. By the end, the character learned blank.","wd":{"ELP 1":"Sort 4 pictures: avoiding problem or facing problem","ELP 2":"Fill in: At first blank, but at the end blank (word bank)","ELP 3":"Write character's beginning and ending thinking with starters","ELP 4":"Explain how the character's mindset changed plus connect to theme","ELP 5-6":"Analyze how the author uses the problem as a symbol; what does it represent?"},"v1":["problem","worry","grow","big","small"],"v2":["theme","growth mindset","perspective","opportunity"],"v3":["symbolism","character arc","implicit theme"],"ac":"Mindset Flip Chart - Students fold paper: Before on left, After on right. Write one quote or evidence for each side.","mn":["Folded flip chart","Thought bubble graphic organizer","Quote sticky notes from text","Sentence frames for both panels"],"sc":["Sentence frames: Before blank and After blank","Bilingual: problem and problema, opportunity and oportunidad"],"df":{"b":"Draw Before and After; write 1 word for each panel","o":"Complete both panels with evidence; write theme sentence","a":"Write a paragraph analyzing the problem as a symbol and connecting to growth mindset","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students may name the problem literally - introduce: What might the cloud REPRESENT in real life?","ELL students may not know growth mindset - define: you believe you CAN get better at things with effort"],"tp":"Ask: Has a problem you had ever turned out to be a good thing in the end?"},"l":{"co":"Describe how a character's thinking changed from beginning to end.","lo":"Use: At first blank, but then blank.","wd":{"ELP 1":"Point to: beginning picture or end picture","ELP 2":"Fill in: At first blank, but then blank (word bank)","ELP 3":"Write beginning and end thinking with starters","ELP 4":"Write 2 sentences plus connect to theme","ELP 5-6":"Write 3 sentences plus personal connection: This is like when I blank"},"v1":["problem","worry","grow"],"v2":["theme","mindset","perspective"],"v3":["symbolism"],"ac":"Before and After Flip - Folded card: draw character thought at beginning and end.","mn":["Folded card template","Thought bubble cards","Sentence frame strip","Crayons"],"sc":["Teacher reads beginning and ending aloud","Pre-drawn before face example","Bilingual: before and antes, after and despues"],"df":{"b":"Draw both sides; label with 1 word each","o":"Draw plus write one sentence for each side","a":"Write 2 sentences plus identify the theme: This story teaches blank","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: written"},"ms":["May focus on physical size of the problem picture - redirect: What was going on INSIDE the character?"],"tp":"Hold up a crumpled piece of paper. Is this trash or could it be useful?"}},
{"u":4,"w":2,"t":"How can asking questions lead to solutions?","x":"Rosie Revere, Engineer","g":"Fiction","s":["3.5a - Character traits","3.5e - Story structure and resolution"],"c":"STEM Connections and Problem Solving","vi":"Unit 5: Listening and Speaking","p":{"co":"Analyze how asking questions and making mistakes leads to solutions.","lo":"Use: Rosie learned blank when blank. This is important because blank.","wd":{"ELP 1":"Match invention picture to the question it answers","ELP 2":"Fill in: Rosie tried blank and learned blank (word bank)","ELP 3":"Write one mistake plus what she learned with starters","ELP 4":"Explain how two attempts led to growth using sequence language","ELP 5-6":"Argue: is failure an important part of problem solving? Use text plus personal evidence"},"v1":["build","try","fail","invent","dream"],"v2":["engineer","iterate","design","solution","attempt"],"v3":["engineering design process","trial and error","resilience"],"ac":"Try It Again Chart - Document: What She Tried, What Happened, What She Learned, What She Changed.","mn":["Try It Again graphic organizer","Engineering process anchor chart","Sticky note learning flags","Sentence frames for each column"],"sc":["Sentence frames for all 4 columns","Engineering vocabulary picture wall","Bilingual: try and intentar, learn and aprender"],"df":{"b":"Fill in columns 2-3 with word bank support","o":"Complete all 4 columns; write 1 synthesis sentence","a":"Write a paragraph: how does Rosie's process reflect the real engineering design process?","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students think failure equals bad ending - reframe: every failure gives information that moves you closer to the solution","ELL students may not know what an engineer does - use picture examples of everyday engineering"],"tp":"Give each student tape and a straw. Build the tallest tower in 2 minutes. When it falls: What did you LEARN?"},"l":{"co":"Explain one thing a character tried and what they learned from it.","lo":"Use: blank tried blank and learned blank.","wd":{"ELP 1":"Point to: what she tried (picture)","ELP 2":"Fill in: She tried blank and learned blank (word bank)","ELP 3":"Write one try plus one learning with starter","ELP 4":"Write 2 sentences: tried plus learned plus what she did differently","ELP 5-6":"Write 3 sentences plus explain why this matters for problem solvers"},"v1":["build","try","fail"],"v2":["engineer","attempt","learn"],"v3":["design process","resilience"],"ac":"Try/Learn Cards - 3 cards with a picture of each attempt. Write and draw what was learned on the back.","mn":["3 attempt picture cards","Sentence frame strip","Mini whiteboard","Sequence mat"],"sc":["Teacher previews each attempt card","Bilingual: try and intentar","Pre-written sentence stem on each card"],"df":{"b":"Match pre-written learning to the correct attempt card","o":"Write one complete sentence for each card","a":"Write paragraph: The most important lesson was blank because blank","e":"ELP 1-2: match and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May think the story ends when the invention fails - clarify: that moment of failure is the MIDDLE, not the end"],"tp":"Before the lesson, ask: Has anyone tried something that did not work the first time and then got better?"}},
{"u":4,"w":3,"t":"How do communities solve big problems together?","x":"The Most Beautiful Roof in the World","g":"Literary Nonfiction","s":["3.6a - Main idea","3.6d - Cause and effect"],"c":"Science and Community and Text Structures","vi":"Unit 5: Reading Fluency","p":{"co":"Explain how a community worked together to solve an environmental problem.","lo":"Use: The community solved blank by working together. This worked because blank.","wd":{"ELP 1":"Point to: Who helped? What was the problem? (pictures)","ELP 2":"Fill in: The community solved blank by blank (word bank)","ELP 3":"Write problem plus community solution plus 1 reason it worked","ELP 4":"Write a summary: problem, community action, result, and why it matters","ELP 5-6":"Evaluate: what makes a community solution more effective than an individual one?"},"v1":["rainforest","protect","discover","research","tree"],"v2":["solution","collaborate","environment","species","investigate"],"v3":["ecological research","collaborative inquiry","conservation movement"],"ac":"Community Solution Web - Central problem in the middle; community members and actions branching out.","mn":["Solution web graphic organizer","Sticky notes","Sentence frame strip","World map: locate the rainforest"],"sc":["Pre-labeled center plus first branch","Bilingual: community and comunidad, protect and proteger","Discussion frames for partner share"],"df":{"b":"Add 2 sticky notes with word bank; copy synthesis sentence","o":"Add 4 sticky notes; write synthesis sentence","a":"Write paragraph: what can our school community do to help the environment?","e":"ELP 1-2: draw and label; ELP 3: frame; ELP 4-6: paragraph"},"ms":["Students think only scientists can solve big problems - reinforce: artists, teachers, and children all contributed here","ELL students may not know what a rainforest is - preview with visuals"],"tp":"Ask: What is one problem in our school you wish someone would fix?"},"l":{"co":"Describe the problem and one way the community helped solve it.","lo":"Use: The problem was blank. The community helped by blank.","wd":{"ELP 1":"Match problem picture to solution picture","ELP 2":"Fill in: The problem was blank and the community blank (word bank)","ELP 3":"Write problem plus solution with starter","ELP 4":"Write 2 sentences: problem plus community action plus why it worked","ELP 5-6":"Write 3 sentences plus opinion: The most important contribution was blank"},"v1":["problem","protect","tree"],"v2":["solution","community","collaborate"],"v3":["conservation"],"ac":"Problem-Solution Cards - 3 problem cards plus 3 solution cards. Match them, then write 1 sentence.","mn":["3 problem cards","3 solution cards","Matching mat","Sentence frame strip"],"sc":["Teacher previews each card aloud","Bilingual: problem and problema, solution and solucion","Picture support on all cards"],"df":{"b":"Match 2 pairs with teacher support; copy sentence","o":"Match all 3 plus write 1 sentence","a":"Write 2 sentences plus predict: What might happen if no one had helped?","e":"ELP 1-2: match and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May not distinguish between the problem and its CAUSE"],"tp":"Ask: Have you ever fixed something at home or helped solve a family problem?"}},
{"u":4,"w":4,"t":"How do we use what we know to solve new problems?","x":"Ada Twist, Scientist","g":"Fiction","s":["3.5a - Character traits and motivation","3.5e - Story structure"],"c":"STEM and Inquiry and Character Analysis","vi":"Unit 5: Academic Vocabulary","p":{"co":"Analyze how a character uses prior knowledge and curiosity to solve a problem.","lo":"Use: Ada used her knowledge of blank to solve blank by doing blank.","wd":{"ELP 1":"Match character action to a problem picture (3 pairs)","ELP 2":"Fill in: Ada solved blank by doing blank (word bank)","ELP 3":"Write how Ada used one piece of knowledge to solve a problem","ELP 4":"Explain how curiosity plus prior knowledge led to Ada's solution with evidence","ELP 5-6":"Compare Ada's problem-solving method to Rosie Revere: what is similar? Different?"},"v1":["question","discover","smell","why","how"],"v2":["curiosity","investigate","hypothesis","knowledge","process"],"v3":["scientific method","inquiry-based learning","prior knowledge"],"ac":"Knowledge Transfer Chart - Map: What Ada Already Knew, New Problem She Faced, How She Used Her Knowledge, What She Discovered.","mn":["4-column knowledge chart","Scientific method anchor chart","Text evidence sticky flags","Vocab cards"],"sc":["Pre-filled column 1 (prior knowledge)","Sentence frames for all 4 columns","Bilingual: curious and curioso, discover and descubrir"],"df":{"b":"Fill in columns 3-4 with word bank","o":"Complete all 4 columns; write 1 synthesis sentence","a":"Compare Ada's method to the scientific method; write a paragraph","e":"ELP 1-2: draw and label; ELP 3: sentence frames; ELP 4-6: paragraph"},"ms":["Students confuse hypothesis with guess - clarify: a hypothesis is an educated guess based on what you already know","ELL students who are curious learners may deeply connect to Ada - affirm that curiosity is a STRENGTH"],"tp":"Ask each student: What is one thing you are SO curious about you cannot stop thinking about it?"},"l":{"co":"Describe one question Ada had and how she tried to answer it.","lo":"Use: Ada wondered blank so she did blank.","wd":{"ELP 1":"Point to a question Ada asked (picture)","ELP 2":"Fill in: Ada wondered blank so she blank (word bank)","ELP 3":"Write one question plus one investigation step with starter","ELP 4":"Write 2 sentences: question, investigation, and result","ELP 5-6":"Write 3 sentences plus personal connection: I am curious about blank"},"v1":["question","discover","why"],"v2":["curious","investigate","hypothesis"],"v3":["scientific method"],"ac":"Wonder/Try Cards - 3 cards with a picture of something Ada wondered about.","mn":["3 wonder picture cards","Sentence frame strip","Mini whiteboard","Scientific method mini-poster"],"sc":["Teacher previews each wonder card","Bilingual: wonder and preguntarse","Pre-written question on each card"],"df":{"b":"Match pre-written investigation to the correct wonder card","o":"Write one complete sentence for each card","a":"Write 3 sentences plus create your own wonder statement","e":"ELP 1-2: match and draw; ELP 3: frame; ELP 4-6: written"},"ms":["May think scientists always get the right answer - reinforce: scientists often try many times"],"tp":"Give each student a sticky note: Write or draw one thing you wonder about."}},
{"u":4,"w":5,"t":"How do we share our solutions with others?","x":"Informational Writing Project Week","g":"Nonfiction Writing","s":["3.7 - Write informational text","3.4 - Domain-specific vocabulary"],"c":"Writing Process and Informational Text","vi":"Unit 5: Grammar in Context","p":{"co":"Plan and draft an informational paragraph about a problem and its solution.","lo":"Write using: The problem is blank. One solution is blank. This works because blank.","wd":{"ELP 1":"Draw the problem and one solution; label 3 key words","ELP 2":"Fill in an informational sentence frame (problem plus solution)","ELP 3":"Write 3 informational sentences: problem, solution, why it works","ELP 4":"Write a complete informational paragraph with transition words and domain vocabulary","ELP 5-6":"Write a multi-paragraph informational piece with introduction, details, and conclusion"},"v1":["problem","solution","because","first","next"],"v2":["inform","describe","evidence","explain","conclude"],"v3":["informational text features","text organization","domain-specific vocabulary"],"ac":"Problem-Solution Draft - Students plan using graphic organizer, draft, peer conference, and revise.","mn":["Problem-Solution planning graphic organizer","Informational writing checklist","Domain vocabulary word bank","Peer conference guide"],"sc":["Sentence frames for all parts of the paragraph","Word bank for problem-solution vocabulary","Bilingual: explain and explicar, describe and describir"],"df":{"b":"Use graphic organizer plus fill-in sentence frames; draw and label supporting details","o":"Complete graphic organizer plus write full paragraph with frames available","a":"Write multi-paragraph piece plus include text features","e":"ELP 1-2: draw and label and copy frame; ELP 3: frames and guided draft; ELP 4-6: independent paragraph"},"ms":["Students write a personal narrative instead of informational text - redirect: informational writing explains facts and ideas, not personal stories","ELL students may have strong ideas but limited English - value the content; do not penalize for grammar errors in draft stage"],"tp":"Have students think back to all 5 units. Ask: What problem do YOU want to tell the world about?"},"l":{"co":"Write 2 informational sentences about a problem and its solution.","lo":"Write: The problem is blank. One solution is blank.","wd":{"ELP 1":"Draw problem plus solution; label 2 key words","ELP 2":"Fill in 2-sentence frame: problem plus solution (word bank)","ELP 3":"Write 2 sentences independently with starters","ELP 4":"Write 3 sentences plus one reason the solution works","ELP 5-6":"Write a short informational paragraph with transition words"},"v1":["problem","solution","help"],"v2":["inform","explain","because"],"v3":["informational text"],"ac":"2-Sentence Draft - Each student writes 2 sentences using the frames. Teacher conferences 1:1 while others write.","mn":["2-sentence graphic organizer","Sentence frame strips (laminated)","Dry-erase markers","Mini word bank card"],"sc":["Teacher reads frame aloud before writing","Bilingual: problem and problema, solution and solucion","Accept L1 first draft; translate together"],"df":{"b":"Draw plus 1 word per sentence with teacher scribing","o":"Write both sentences independently","a":"Add a 3rd sentence: This helps because blank","e":"ELP 1-2: draw and copy frame; ELP 3: guided sentences; ELP 4-6: short paragraph"},"ms":["Students may write I think - redirect to informational voice: One solution is..."],"tp":"Show each student their Wonder Wall sticky note from Week 4. Did you find an answer? Now write about it."}}
